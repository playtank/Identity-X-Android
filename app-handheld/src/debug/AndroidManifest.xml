<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug manifest overlay — merged with src/main/AndroidManifest.xml in debug builds only.
    Sets the network security config that permits cleartext HTTP to local dev servers.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
